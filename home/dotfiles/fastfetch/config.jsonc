{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    {
      "type": "command",
      "key": "Installed",
      "text": "d=$(stat -c %W /); now=$(date +%s); days=$(( (now - d) / 86400 )); echo \"$days days (since $(date -d @$d +%F))\""
    },
    "os",
    "time",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ],
  "logo": {
    "color": {
      "1": "#f563ff",
      "2": "#e963ee"
    }
  },
  "display": {
    "color": {
      "keys": "#f5aeff",
      "title": "#e9b5ee"
    },
    "percent": {
      "color": {
        "green": "#ffb3b5",
        "yellow": "#f5aeff",
        "red": "#ffb4ab"
      }
    }
  }
}
